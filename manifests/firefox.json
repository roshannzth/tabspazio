{
  "manifest_version": 3,
  "name": "TabSpazio - New Tab Launcher",
  "version": "1.0.2",
  "description": "Transform your new tab into a sleek, customizable modern UI app launcher",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "roshannzth",
  "homepage_url": "https://github.com/roshannzth/tabspazio",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabspazio@roshannzth.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
